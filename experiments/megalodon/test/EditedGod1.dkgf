positive_definite_hermitian_form : "the hermitian form #9 is positive definite" | $#9(x,x)>0\ (x\ne0)$
positive_semidefinite_hermitian_form : "the hermitian form #9 is positive semidefinite" | $#9(x,x)\ge0$
negative_semidefinite_hermitian_form : "the hermitian form #9 is negative semidefinite" | $#9(x,x)\le0$
indefinite_hermitian_form : "the hermitian form #9 is indefinite" | $#9\text{ is indefinite}$
hermitian_form_automorphism : "#10 is an automorphism of hermitian form #9" | $#10\in\operatorname{GL}(#9)$
hermitian_form_automorphism_group : "the group of automorphisms of form #9" | $\operatorname{GL}(#9)$
orthogonal_matrix : "the square matrix #5 is orthogonal" | ${}^t#5\,#5=1$
orthogonal_group : "the orthogonal group in #4 variables over #1" | $\operatorname O(#4,#1)$
special_orthogonal_group : "the special orthogonal group in #4 variables over #1" | $\operatorname{SO}(#4,#1)$
unitary_matrix : "the square matrix #6 is unitary relative to involution #4" | $#6^*#6=1$
unitary_group : "the unitary group in #5 variables over #1" | $\operatorname U(#5,#1)$
normal_endomorphism : "the endomorphism #10 is normal relative to form #9" | $#10^*#10=#10#10^*$
normal_matrix : "the complex square matrix #5 is normal" | $#5^*#5=#5#5^*$
self_adjoint_endomorphism : "the endomorphism #10 is self-adjoint relative to form #9" | $#10^*=#10$
definite_hermitian_form : "the real or complex hermitian form #9 is definite" | $#9\text{ is definite}$
hermitian_form_norm : "the seminorm induced by the positive hermitian form #9" | $\|#10\|=\sqrt{#9(#10,#10)}$
